# ============================================================
# AI-READI Dashboard — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ---- Dataset -----------------------------------------------
# Absolute path to the AI-READI dataset root on your VM or local
DATASET_ROOT=/path/to/your/f9e65119-3f27-4525-a140-b4413222991d/dataset

# ---- Backend -----------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Set to "production" to disable /docs and /redoc
ENVIRONMENT=development

# ---- Frontend ----------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---- Optional: Claude AI summaries -------------------------
# Leave blank to disable AI-generated clinical summaries
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ---- CORS --------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
